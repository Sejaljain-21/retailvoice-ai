# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.db binary

# Keep generated lockfiles out of diffs and language stats.
frontend/package-lock.json linguist-generated=true -diff

# =============================================================================
# RetailVoice AI - environment configuration
#
# Copy to `.env` at the repository root and edit. EVERY setting has a working
# default, so the project runs with an empty file - no API keys required.
#   cp .env.example .env
# =============================================================================

# ----------------------------------------------------------------- app -----
APP_NAME="RetailVoice AI"
APP_ENV=development                 # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1

# --------------------------------------------------------------- security --
# Generate a real one for anything but local development:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-in-production-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=20160
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --------------------------------------------------------------- database --
# SQLite needs no server and is the default.
DATABASE_URL=sqlite+aiosqlite:///./retailvoice.db
# PostgreSQL (used by docker-compose):
# DATABASE_URL=postgresql+asyncpg://retailvoice:retailvoice@localhost:5432/retailvoice
DB_ECHO=false

# ------------------------------------------------------------------- LLM ---
# auto -> use Claude when ANTHROPIC_API_KEY is set, otherwise the offline
# rule-based planner. Set to `mock` to force offline, `anthropic` to require it.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.3
AGENT_MAX_TOOL_ITERATIONS=6

# ------------------------------------------------------------------ speech --
# STT: browser (default, zero-config) | whisper (local) | deepgram | mock
STT_PROVIDER=browser
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
DEEPGRAM_API_KEY=

# TTS: browser (default) | elevenlabs | pyttsx3 (offline OS voices) | mock
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --------------------------------------------------------------- retrieval --
# hashing (default, no download) | sentence-transformers (better recall)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_TOP_K=4
RAG_MIN_SCORE=0.12
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120

# ------------------------------------------------------------------ policy --
ESCALATION_SENTIMENT_THRESHOLD=-0.55
ESCALATION_MAX_TURNS_WITHOUT_RESOLUTION=8
ESCALATION_REFUND_AMOUNT_LIMIT=5000
GOODWILL_COUPON_MAX_VALUE=500
ENABLE_PII_REDACTION=true
# DEMO ONLY - turn this off in production, order data belongs behind auth.
ALLOW_ANONYMOUS_ORDER_LOOKUP=true

# ------------------------------------------------------------------ voice ---
VOICE_MAX_SESSION_SECONDS=900
VOICE_SILENCE_TIMEOUT_MS=1500

# ------------------------------------------------------------------- seed ---
SEED_ON_STARTUP=true
DEMO_ADMIN_EMAIL=admin@retailvoice.ai
DEMO_ADMIN_PASSWORD=Admin@123

# --------------------------------------------------------------- frontend --
# Read by Vite at build time. Leave unset to use the dev-server proxy.
# VITE_API_BASE_URL=/api/v1
# VITE_WS_HOST=localhost:8000
